# Copia in .env.local (sviluppo) o imposta le variabili sull'hosting.
# Nessuna di queste variabili è configurata: il modulo resta in modalità dimostrativa.

# --- Server (mai esposte al browser) ---
# Endpoint del CRM / automazione che riceve le candidature (POST JSON).
LEAD_WEBHOOK_URL=
# Facoltativo: inviato come "Authorization: Bearer <valore>" al webhook.
LEAD_WEBHOOK_SECRET=

# --- Pubbliche (finiscono nel bundle: niente segreti) ---
# URL reale dell'informativa privacy approvata. Senza, il modulo non invia dati.
NEXT_PUBLIC_PRIVACY_POLICY_URL=
# Dominio definitivo, es. https://www.esempio.it (abilita canonical, og:url, og:image).
NEXT_PUBLIC_SITE_URL=
# "true" solo al go-live: altrimenti la pagina è noindex.
NEXT_PUBLIC_ALLOW_INDEXING=
# "true" solo dopo aver collegato GTM/GA4 e il banner di consenso.
NEXT_PUBLIC_ANALYTICS_ENABLED=
